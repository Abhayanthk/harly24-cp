long long bitStringLSBFirstToNumber(const string &s) {
    long long res = 0;
    long long pow2 = 1;
    for (char c : s) {
        if (c == '1') res += pow2;
        pow2 <<= 1;  // multiply by 2 for next bit
    }
    return res;
}

