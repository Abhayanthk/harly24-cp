template <typename T>
vector<T> makeUnique(vector<T> &vec) {
    vector<T> temp;
    unordered_map<T, long long> mp;
    for (const auto &e : vec) {
        if (mp[e]++ == 0) {
            temp.push_back(e);
        }
    }
    return temp;
}]]></content>
