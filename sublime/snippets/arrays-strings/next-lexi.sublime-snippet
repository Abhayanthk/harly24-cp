string nextLexi(std::string s) {
    int i = s.length() - 1;

    while (i >= 0 && s[i] == 'z') {
        s[i] = 'a';
        i--;
    }

    if (i >= 0) {
        s[i]++;
    } else {
        // Overflow, like from "zz" → "aaa"
        s = 'a' + s;
    }

    return s;
}
]]></content>
