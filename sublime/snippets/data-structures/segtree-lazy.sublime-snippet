// ─── Segment Tree — Range Update (add), Range Sum — Lazy Prop ───

const int MAXN = 1e5 + 5;
long long tree[4*MAXN], lazy[4*MAXN];

// Push pending lazy value down to children
void pushDown(int node, int l, int r) {
    if (!lazy[node]) return;
    int mid = (l + r) / 2;
    tree[2*node]   += lazy[node] * (mid - l + 1);
    tree[2*node+1] += lazy[node] * (r - mid);
    lazy[2*node]   += lazy[node];
    lazy[2*node+1] += lazy[node];
    lazy[node] = 0;
}

void build(long long a[], int node, int l, int r) {
    lazy[node] = 0;
    if (l == r) { tree[node] = a[l]; return; }
    int mid = (l + r) / 2;
    build(a, 2*node,   l,   mid);
    build(a, 2*node+1, mid+1, r);
    tree[node] = tree[2*node] + tree[2*node+1];
}

// Range update: add val to every element in [ql, qr]
void update(int node, int l, int r, int ql, int qr, long long val) {
    if (qr < l || r < ql) return;
    if (ql <= l && r <= qr) {
        tree[node] += val * (r - l + 1);
        lazy[node] += val;
        return;
    }
    pushDown(node, l, r);
    int mid = (l + r) / 2;
    update(2*node,   l,   mid, ql, qr, val);
    update(2*node+1, mid+1, r, ql, qr, val);
    tree[node] = tree[2*node] + tree[2*node+1];
}

// Range query: sum of a[ql..qr]
long long query(int node, int l, int r, int ql, int qr) {
    if (qr < l || r < ql) return 0;
    if (ql <= l && r <= qr) return tree[node];
    pushDown(node, l, r);
    int mid = (l + r) / 2;
    return query(2*node,   l,   mid, ql, qr)
         + query(2*node+1, mid+1, r, ql, qr);
}

// Usage:
//   build(a, 1, 1, n);
//   update(1, 1, n, l, r, val);   // add val to range [l, r]
//   long long ans = query(1, 1, n, l, r);
