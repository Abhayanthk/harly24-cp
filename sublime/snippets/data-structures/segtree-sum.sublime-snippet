// ─── Segment Tree — Point Update, Range Sum Query ───────────────

const int MAXN = 1e5 + 5;
long long tree[4 * MAXN];  // always allocate 4*N

// Build from array a[], node covers [l, r]
void build(long long a[], int node, int l, int r) {
    if (l == r) { tree[node] = a[l]; return; }
    int mid = (l + r) / 2;
    build(a, 2*node,   l,   mid);
    build(a, 2*node+1, mid+1, r);
    tree[node] = tree[2*node] + tree[2*node+1];
}

// Point update: set a[idx] = val
void update(int node, int l, int r, int idx, long long val) {
    if (l == r) { tree[node] = val; return; }
    int mid = (l + r) / 2;
    if (idx <= mid) update(2*node,   l,   mid, idx, val);
    else            update(2*node+1, mid+1, r, idx, val);
    tree[node] = tree[2*node] + tree[2*node+1];
}

// Range query: sum of a[ql..qr]
long long query(int node, int l, int r, int ql, int qr) {
    if (qr < l || r < ql) return 0;       // out of range
    if (ql <= l && r <= qr) return tree[node]; // fully covered
    int mid = (l + r) / 2;
    return query(2*node,   l,   mid, ql, qr)
         + query(2*node+1, mid+1, r, ql, qr);
}

// Usage (1-indexed array of size n):
//   build(a, 1, 1, n);
//   update(1, 1, n, idx, val);
//   long long ans = query(1, 1, n, l, r);
