vi factors(int n)
{
    vi temp;
    for(int i = 1; i*i <= n; i++)
    {
        if(n % i == 0)
        {
            temp.pb(i);
            if(n/i != i)
            {
                temp.pb(n/i);
            }
        }
    }
    return temp;
}
]]></content>
